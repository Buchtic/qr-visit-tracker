# Cloudflare Pages — bezpečnostní hlavičky
# Dokumentace: https://developers.cloudflare.com/pages/platform/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-XSS-Protection: 1; mode=block

# CSP pro veřejnou stránku
# cdnjs.cloudflare.com — Bootstrap CSS+JS, Chart.js (script-src i style-src)
/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self'; img-src 'self' data: https://unpkg.com; connect-src 'self'; frame-ancestors 'none'

# CSP pro admin
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://ka-f.webawesome.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://ka-f.webawesome.com; font-src 'self' https://ka-f.webawesome.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'

# Vendor soubory — agresivní cache
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
