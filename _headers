# Cloudflare Pages — bezpečnostní hlavičky
# Platí pro všechny stránky pokud není níže přepsáno

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-XSS-Protection: 1; mode=block

# Přísnější CSP pro veřejnou stránku
# 'unsafe-inline' je potřeba pro Bootstrap accordiony a inline styly
# Pokud odstraníte inline styly, lze zpřísnit na 'none'
/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://ka-f.webawesome.com; font-src 'self' https://ka-f.webawesome.com; img-src 'self' data: https://unpkg.com; connect-src 'self'; frame-ancestors 'none'

# Admin — stejná CSP
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'

# Vendor soubory — agresivní cache (nemění se bez nové verze)
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
